{
  "google": {
    "key_file": "service-account-key.json",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.readonly"
    ],
    "calendar_id": "YOUR_CALENDAR_ID",
    "pray_id": "YOUR_PRAY_ID"
  },
  "sr201": {
    "enabled": false,
    "ip": "192.168.100.100",
    "port": 6722,
    "relay": 1,
    "timeout_seconds": 5,
    "relay_pause_seconds": 5
  },
  "mill": {
    "enabled": true,
    "ip": "192.168.0.173",
    "temp_type": "Normal",
    "heat_on_temp": 21,
    "heat_off_temp": 17
  },
  "glamox": {
    "enabled": true,
    "room_name": "Storsalen",
    "api_url": "https://api-1.glamoxheating.com/client-api",
    "heat_on_temp": 21,
    "heat_off_temp": 17
  },
  "arp": {
    "interface": "wlan0",
    "alias_file": "scripts/arp_alias",
    "alias_prefix": "glamox_ovn_",
    "command": ["sudo", "arp-scan", "-I", "{interface}", "--localnet"],
    "emit_summary": true
  },
  "logging": {
    "python_config_file": "logging.config",
    "console": {
      "enabled": true,
      "level": "INFO"
    },
    "file": {
      "enabled": false,
      "level": "DEBUG",
      "path": "BedehusTemperaturProgram.log",
      "max_bytes": 1024,
      "backup_count": 31
    },
    "syslog": {
      "enabled": true,
      "level": "INFO",
      "address": "10.253.4.1:5515"
    }
  },
  "cache": {
    "google_max_age_hours": 24
  },
  "timing": {
    "enabled": false
  },
  "state_db": {
    "path": "config/relay_state.db"
  },
  "time_window_hours": 2
}
