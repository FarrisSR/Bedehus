[Unit]
Description=Bedehus auto-update timer

[Timer]
# Sjekk én gang i timen, kun mellom 07 og 22 – reduserer trafikk mot GitHub
# til et minimum. Manuell oppdatering utenom dette vinduet:
#   sudo systemctl start bedehus-updater.service
OnCalendar=*-*-* 07..22:00:00
# Tilfeldig forsinkelse på opptil 5 min (nyttig ved flere Pi-er som deler vindu)
RandomizedDelaySec=5min
# Kjør umiddelbart neste gang dersom Pi var av under planlagt kjøring
Persistent=true

[Install]
WantedBy=timers.target
